# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

notes.sh

# GCP service account keys
/.gcp-key/
.gcp-key.json

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Terraform - General patterns
*.tfvars
!devops/terraform/bootstrap/terraform.tfvars
.terraform/
.terraform.lock.hcl
terraform.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform State Files
# All terraform directories except bootstrap use remote state - exclude local state files
devops/terraform/*/*.tfstate
devops/terraform/*/*.tfstate.*

# Bootstrap directory uses local state - include state files (they must be committed)
# The bootstrap state files are critical for team collaboration and state bucket management
!devops/terraform/bootstrap/*.tfstate
!devops/terraform/bootstrap/*.tfstate.*

# Backend config files created temporarily during terraform init
.backend-config-*.hcl
